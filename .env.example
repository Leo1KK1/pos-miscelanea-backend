# Puerto local para el servidor Express
PORT=3000

# Credenciales públicas del proyecto de Supabase (Desarrollo)
# Nunca coloques aquí SUPABASE_SERVICE_ROLE_KEY ni contraseñas de base de datos si no son estrictamente requeridas en servidor
SUPABASE_URL=https://tu-proyecto-dev.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplazar_con_tu_clave

# Secreto del servidor para firmar constancias de vigencia offline (Grace Period - Punto 6)
# Genera uno aleatorio de al menos 32 bytes para desarrollo (ej: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
OFFLINE_LICENSE_SECRET=reemplazar_con_secreto_hex_de_64_caracteres
