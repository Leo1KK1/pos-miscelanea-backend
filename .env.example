# Puerto local para el servidor Express
PORT=3000

# Credenciales públicas del proyecto de Supabase (Desarrollo)
# Nunca coloques aquí SUPABASE_SERVICE_ROLE_KEY ni contraseñas de base de datos
SUPABASE_URL=https://tu-proyecto-dev.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplazar_con_tu_clave

# Par de claves asimétricas Ed25519 (DER en Base64) para firmar constancias de vigencia offline (Regla 6)
# El servidor firma con la clave privada; la app Flutter solo conoce la clave pública para verificar sin conexión.
# Generar un par nuevo:
# node -e "const c=require('crypto'),k=c.generateKeyPairSync('ed25519');console.log('OFFLINE_LICENSE_PRIVATE_KEY_B64='+k.privateKey.export({type:'pkcs8',format:'der'}).toString('base64')+'\nOFFLINE_LICENSE_PUBLIC_KEY_B64='+k.publicKey.export({type:'spki',format:'der'}).toString('base64'))"
OFFLINE_LICENSE_PRIVATE_KEY_B64=reemplazar_con_clave_privada_ed25519_pkcs8_base64
OFFLINE_LICENSE_PUBLIC_KEY_B64=reemplazar_con_clave_publica_ed25519_spki_base64
